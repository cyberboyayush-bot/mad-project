<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted session is bound to this device's keystore, so never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
